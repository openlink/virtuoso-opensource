<?vsp
  -- VVec · predicate lookup AJAX endpoint.
  --   GET /vvec/predicates.vsp?g=<graph iri>&limit=<n>
  -- Returns JSON listing the predicates used in that graph whose objects are
  -- string literals -- the ones a shorthand vector index can embed.  Read-only
  -- and idempotent (a GET, so no CSRF token is needed), and served behind the
  -- same /vvec/ session guard as every other console page, running as
  -- vsp_user 'dba'.
  -- NOTE: as with lookup.vsp and graphs.vsp, a DAV-hosted executable VSP is
  -- served as text/html whatever this http_header says; the body is still valid
  -- JSON and the client parses it with fetch().json().
  set http_charset='utf-8';
  http_header (sprintf ('Content-Type: application/json; charset=UTF-8\r\n'));
  http (DB.DBA.VVEC_PREDICATES_JSON (get_keyword ('g', params, ''),
                                        atoi (get_keyword ('limit', params, '300'))));
?>
